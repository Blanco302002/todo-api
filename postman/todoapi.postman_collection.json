{
  "info": {
    "name": "todoapi",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/tasks" }
  ],
  "item": [
    {
      "name": "List tasks",
      "request": { "method": "GET", "url": "{{baseUrl}}" }
    },
    {
      "name": "Get one task",
      "request": { "method": "GET", "url": "{{baseUrl}}/1" }
    },
    {
      "name": "Create task",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Study Spring\",\n  \"description\": \"Finish the REST section\"\n}" }
      }
    },
    {
      "name": "Create task without title (400)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"\",\n  \"description\": \"this should fail\"\n}" }
      }
    },
    {
      "name": "Update task",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/1",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Study Spring REST\",\n  \"description\": \"Almost done\"\n}" }
      }
    },
    {
      "name": "Delete task",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/1" }
    }
  ]
}
